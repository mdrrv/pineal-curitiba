# Banco do Pineal (PostGIS). Ou use PINEAL_DSN="host=... dbname=... user=... password=..."
PINEAL_DB_HOST=localhost
PINEAL_DB_PORT=5432
PINEAL_DB_NAME=pineal
PINEAL_DB_USER=postgres
PINEAL_DB_PASSWORD=

# Banco onde está dados_rfb.cnpj_consolidado (ETL da MINDATA).
# Deixe RFB_DB_NAME vazio se for o mesmo banco do Pineal. Ou use RFB_DSN.
RFB_DB_HOST=localhost
RFB_DB_PORT=5432
RFB_DB_NAME=dados_rfb
RFB_DB_USER=postgres
RFB_DB_PASSWORD=

# Município (padrão: Curitiba)
PINEAL_COD_IBGE=4106902
PINEAL_COD_RFB=7535
PINEAL_NOME_MUNICIPIO=CURITIBA
PINEAL_UF=PR

# Pasta dos arquivos baixados (padrão: ./dados)
# PINEAL_DADOS=D:/pineal/dados

# Testes: banco descartável, o schema cwb é apagado e recriado
# PINEAL_TEST_DSN=host=localhost port=5432 dbname=pineal_teste user=postgres password=
